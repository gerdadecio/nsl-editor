<%= form_for(@author, as: 'author', role: 'form', remote: true, data: { turbo: false }
    ) do |f| %>
    <% if @author.errors.any? %>
        <div id="error_explanation">
          <h6><%= pluralize(@author.errors.count, "error") %> prohibited this author from being saved:</h6>

          <ul>
            <% @author.errors.full_messages.each do |message| %>
                <li><%= message %></li>
            <% end %>
          </ul>
        </div>
    <% end %>
    <div id="search-result-details-info-message-container" class="message-container"></div>
    <div id="search-result-details-error-message-container" class="message-container"></div>
    <br>
    <input type="hidden" name="random_id" value="<%= params[:random_id] %>"/>

    <div class="form-group">
      <label for="name">Name<span class="red">*</span></label>
      <%= f.text_field :name, class: 'form-control give-me-focus', required: true,  title: "Enter author name", tabindex: increment_tab_index, autofocus: true %>
      <p class="help-block">e.g. Fischer, F.E.L. von, Meyer, C.A.A. von &amp; Ave-Lallelant, J.L.E.</p>
    </div>

    <div class="form-group">
      <label for="abbrev">Abbreviation</label>
      <%= f.text_field :abbrev, class: 'form-control', title: 'Enter author abbreviation', tabindex: increment_tab_index %>
    </div>

    <div class="form-group">
      <label for="extra_information">Extra information to distinguish name</label>
      <%= f.text_field :extra_information, class: 'form-control', title: "Enter any optional information to distinguish this author from others with similar names.", tabindex: increment_tab_index %>
      <p class="help-block">Will display beside the author's name and in authority typeaheads.</p>
    </div>

    <div class="form-group">
      <label for="notes">Notes</label>
      <%= f.text_area :notes, class: 'form-control', title: "Enter author notes", tabindex: increment_tab_index %>
    </div>

    <% unless @author.new_record? %>
        <%# Duplicate of: on stimulus-autocomplete, instead of the typeahead.js
            widget set up by setUpAuthorDuplicateOfTypeahead (now gone). The
            current author's id is in the url path, so an author is never
            offered as a duplicate of itself - the job the old widget's
            data-excluded-id did. Author::AsResolvedTypeahead::ForDuplicateOf
            is unchanged: it cuts the "<name> | <n> refs | <abbrev>" label at
            the first "|", and term_delimiter cuts the search term there too,
            so editing a filled-in field searches on the name alone. The
            input keeps its dom id for update.js.erb. %>
        <%= render "shared/autocomplete_field",
                   f: f,
                   id_attribute: :duplicate_of_id,
                   input_id: "author-duplicate-of-typeahead",
                   input_name: "author[duplicate_of_typeahead]",
                   input_value: @author.duplicate_of.try("name_and_or_abbrev"),
                   label: "Duplicate of",
                   title: "Enter author this is a duplicate of. Typeahead field - enter an author name or select one from the list which appears as you type. Not case-sensitive. No auto-wildcarding. Recognises text.",
                   url: authors_typeahead_on_name_duplicate_of_current_path(id: @author.id, format: :html),
                   term_delimiter: "|" %>

    <% end %>

    <hr>

    <div class="form-group align-right">
      <% if @tab.blank? %>
          <%= link_to 'Cancel', '/cancel-new-form', class: "btn btn-primary cancel-new-record-link", title: "Cancel new author", tabindex: increment_tab_index, data: {element_id: "new-author-#{params[:random_id]}"} %>
      <% end %>
      <%= f.submit "Save", id: 'author-save', class: 'btn btn-primary width-5em', title: "Save changes", tabindex: increment_tab_index, disabled: false %>
    </div>

<% end %>

<% if @take_focus %>
  <script>
    $(document).ready(function () {
      focusOnField('author_name');
    })
  </script>
<% end %>
