<%= form_for(Instance.new,  url: { action: "create_cited_by" }, remote: true, data: { turbo: false }) do |f| %>
    <% if @instance.errors.any? %>
        <div id="error_explanation">
            <h2><%= pluralize(@instance.errors.count, "error") %> prohibited this instance from being saved:</h2>

            <ul>
                <% @instance.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                <% end %>
            </ul>
        </div>
    <% end %>

    In
    <%= show_field_as_linked_lookup('',@instance.reference,'citation', search_path(query_string: %Q(id:#{@instance.reference_id}),query_target: 'reference'),'reference') %>
    the name<span class="red">*</span>
    <%# Name: on stimulus-autocomplete, as in _form_create_synonymy, instead
        of the typeahead.js widget set up by setUpInstanceNameForUnpubCitation
        (now gone). The instance's own name is left out by the endpoint, its id
        now sent as a static param rather than read off #context-name-id at
        query time.

        No label: the field sits inside a sentence. The shared partial renders
        the hidden name_id field inside the wrapper - same dom id and param
        name - empty until a pick. input_name stays, because create_cited_by
        resolves the typed text when no name was picked.

        term_delimiter keeps a pick from poisoning the next search: the
        suggestions read "<full name> - <status>". %>
    <div class="typeahead-container">
      <section class='block width-100-percent'>
        <%= render "shared/autocomplete_field",
                   f: f,
                   id_attribute: :name_id,
                   input_id: "instance-name-typeahead",
                   input_name: "instance[name_typeahead]",
                   input_value: "",
                   input_class: "width-100-percent give-me-focus",
                   required: true,
                   placeholder: "Instance for unpublished citation - typeahead using name",
                   title: "Enter an instance.  Typeahead field on name.",
                   url: names_typeahead_for_unpub_cit_path(format: :html),
                   extra_params: { context_name_id: @instance.name_id },
                   term_delimiter: " - " %>
      </section>
    </div>
    is used as a type<span class="red">*</span>
    <br>
    <%= f.select(:instance_type_id, InstanceType.unpublished_citation_options,{include_blank: true},
                 {value: @instance.instance_type_id,data:{update_url: instance_path},
                  class: 'form-control width-50-percent', title: 'Enter instance type',
                  required: true, tabindex: increment_tab_index}) %>
    of <%= @instance.name.full_name %>
    <br>
    on page
    <br>
    <%= f.text_field :page, title: 'Enter page details', tabindex: increment_tab_index %>
    <br>
    <%= f.hidden_field :context_name_id, id: 'context-name-id', value: @instance.name_id %>
    <%= f.hidden_field :reference_id, value: @instance.reference_id %>
    <%= f.hidden_field :cited_by_id, value: @instance.id %>
    <%= f.hidden_field :cites_id %>
    <br>
    <%= f.submit class: 'btn-primary', title: 'Save changes', tabindex: increment_tab_index %>
    <br>
    <br>
    <br>
    <br>
    <% refresh_page_link = link_to("Refresh page",
                                   '#', 
                                   id: "refresh-page-from-details-link",
                                   class: "btn btn-default hidden",
                                   title: "Refresh page",
                                   data: {instance_note_id: @instance.id},
                                   tabindex: increment_tab_index) 
   %>
   <%= refresh_page_link %>
<% end %>

<% if @take_focus %>
  <script>
    $(document).ready(function () {
      focusOnField('instance-name-typeahead');
    })
  </script>
<% end %>

