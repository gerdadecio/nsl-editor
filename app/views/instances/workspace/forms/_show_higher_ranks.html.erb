<%# The "Show higher ranks" box beside a tree workspace Parent field. The
    field sends it with every query as allow_higher_ranks (1 when ticked, 0
    when not) through its live_params, so ticking it takes effect on the
    next keystroke without reloading the form. %>
<label class="custom-control custom-checkbox float-end">
  Show higher ranks
  <input type="checkbox" id="allow_higher_ranks" value="false"/>
</label>
