<div class="typeahead-container">
  <%# Parent: on stimulus-autocomplete - see trees/_update_parent.html.erb,
      which sets up the same field for the draft's Update parent form. %>
  <%= render "shared/autocomplete_field",
             f: nil,
             id_attribute: nil,
             input_id: "workspace_parent_name_typeahead",
             input_name: "move_placement[parent_name_typeahead_string]",
             input_value: @tree_version_element&.parent&.tree_element&.name&.full_name,
             label: "Replace current concept with this one under",
             title: "Select a name from the suggestions as you type.",
             placeholder: "Name suggestions",
             input_class: "width-100-percent",
             required: true,
             url: workspace_parent_name_suggestions_path(format: :html),
             extra_params: { name_id: @instance.name.id,
                             parent_element_id: @tree_version_element&.parent&.element_link, },
             live_params: { allow_higher_ranks: "allow_higher_ranks" },
             term_delimiter: " -",
             hidden_name: "move_placement[parent_element_link]",
             hidden_id: "workspace_parent_name_id",
             id_value: @tree_version_element&.parent&.element_link %>
  <%# Outside the field's own wrapper div: .autocomplete-results is
      positioned at top: 100% of that wrapper, so anything else inside it
      would push the suggestion dropdown down below it. %>
  <span class="small">You must select from the drop down list.</span>
  <%= render "instances/workspace/forms/show_higher_ranks" %>
</div>
