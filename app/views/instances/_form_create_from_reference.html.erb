
<%= form_for(Instance.new,  url: { controller: 'instances', action: "create" }, remote: true, data: { turbo: false }) do |f| %>
    <% if @instance && @instance.errors.any? %>
        <div id="error_explanation">
            <h2><%= pluralize(@instance.errors.count, "error") %> prohibited this instance from being saved:</h2>

            <ul>
                <% @instance.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                <% end %>
            </ul>
        </div>
    <% end %>
    The name
    <%# Name: powered by stimulus-autocomplete instead of the vendored
        typeahead.js/Bloodhound widget (the setUpInstanceName call and its
        nameByFullName source in typeaheads/for_instance/name.js, both now
        gone), following the name form's author and parent fields. Dom id,
        classes, title, placeholder and tab order are unchanged, so the GUI
        is the same and the JS that keys off the id carries on untouched:
        the focusOnField call at the bottom of this form, the
        .give-me-focus hook in search_result_focus.js, and the
        render_create_error calls in InstancesController.

        No label local: this field sits inside the "The name ... appears in
        ..." sentence the form is written as, and never had a <label>.

        The hidden name_id field the old markup rendered further down the
        form is now rendered by the shared partial, inside the wrapper,
        where the library expects it - same dom id and param name.

        input_name is only there because the partial needs one; this form's
        create action reads the picked name_id and ignores the typed text,
        as it did when the old input had no name attribute at all. The
        same param name is what the unpublished-citation form's Name field
        already submits.

        term_delimiter keeps a pick from poisoning the next search: the
        suggestions read "<full name> - <status>", and picking one puts all
        of that into the input. %>
    <div class="typeahead-container">
      <%= render "shared/autocomplete_field",
                 f: f,
                 id_attribute: :name_id,
                 input_id: "instance-name-typeahead",
                 input_name: "instance[name_typeahead]",
                 input_value: "",
                 input_class: "width-100-percent give-me-focus",
                 placeholder: "Name",
                 title: "Select a name from the list of suggestions that appears as you type.",
                 url: names_typeahead_on_full_name_path(format: :html),
                 term_delimiter: " - " %>
    </div>
    appears in
    <%= show_field_as_linked_lookup('',@reference,'citation', search_path(query_string: %Q(id:#{@reference.id}),query_target: 'reference'),'reference') %>
    as an instance type<span class="red">*</span>
    <%= render partial: 'detail_line', locals: {
            info: f.select(:instance_type_id, InstanceType.standalone_options,{include_blank: true},
                           {value: @instance.try('instance_type_id'),data:{update_url: instance_path},
                            class: 'form-control width-50-percent', title: "Select instance type", required: true, tabindex: increment_tab_index}),
            label:''
    }
    %>
    on page
    <%= f.text_field :page, class: 'form-control width-50-percent', title: "Enter the page details for the name usage", tabindex: increment_tab_index %>
    <br>
    with verbatim name
    <br>
    <%= f.text_field :verbatim_name_string, class: "form-control", title: "The verbatim or literal name as it occurs, if non-standard.", tabindex: increment_tab_index %>
    with BHL URL
    <%= f.text_field :bhl_url, class: "form-control", title: "Biodiversity Heritage Library link address", tabindex: increment_tab_index %>
    <%= render partial: "instances/widgets/as_a_draft", locals: {f: f} %>
    <br>
    <%= f.hidden_field :reference_id, value: @reference.id %>
    <br>
    <%= f.submit id: "save-new-instance-btn", class: 'btn-primary', title: "Create the new instance", tabindex: increment_tab_index %>
    
    <br>
    <div id="multiple-primary-override" class="hidden form-check override-container">
      <br>
      <label class="green form-check-label">
      <%= f.check_box(:multiple_primary_override,{title: "Override the warning about multiple primary instances"}) %>
        Ignore the warning and create the extra primary instance.
      </label>
    </div>
    <br>
    <div id="duplicate-instance-override" class="hidden form-check override-container">
      <br>
      <label class="green form-check-label">
      <%= f.check_box(:duplicate_instance_override,{title: "Override the duplicate instance error message"}) %>
        Ignore the error and create a duplicate instance.
      </label>
    </div>
    <br>
    <% refresh_page_link = link_to("Refresh page",
                                   '#', 
                                   id: "refresh-page-from-details-link",
                                   class: "btn btn-default hidden",
                                   title: "Refresh page",
                                   data: {instance_note_id: @instance.try('id')}) 
   %>
   <%= refresh_page_link %>
<% end %>

<% if @take_focus %>
  <script>
    $(document).ready(function () {
      focusOnField('instance-name-typeahead');
    })
  </script>
<% end %>

