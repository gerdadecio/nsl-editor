<%= divider %>
Change the reference for this instance and its 
<%= link_to("#{pluralize(@instance.reverse_of_this_is_cited_by.size,'synonym')}. #{search_icon_on_tab}".html_safe,
            search_path(query_string: @instance.id.to_s, query_target: 'instance is cited by'),
            tabindex: increment_tab_index,
            title: "Search for the #{pluralize(@instance.reverse_of_this_is_cited_by.size,'synonym')}"
           )%>

<br>
<br>
<%= form_for(@instance, url: {action: 'change_reference'}, html: {id: "change-reference-form", class: "change-reference-form", method: :patch, remote: true, data: { turbo: false }}) do |f| %>
    <% if @instance.errors.any? %>
        <div id="error_explanation">
          <h2><%= pluralize(@instance.errors.count, "error") %> prohibited this instance from being saved:</h2>
          <ul>
            <% @instance.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
    <% end %>
        <%# Reference: on stimulus-autocomplete, as in
            _form_create_from_name. The shared partial renders the hidden
            reference_id field; dom ids and param names are unchanged. %>
        <%= render "shared/autocomplete_field",
                   f: f,
                   id_attribute: :reference_id,
                   input_id: "instance-reference-typeahead",
                   input_name: "instance[reference_typeahead]",
                   input_value: @instance.reference.try("citation"),
                   required: true,
                   placeholder: "Reference",
                   title: "Reference typeahead.  Enter text to see matching references.",
                   url: references_typeahead_on_citation_path(format: :html),
                   term_delimiter: " |" %>

    <br>
    <%=
      f.submit class: 'btn btn-primary pull-right width-5em no-right-margin',
               value: 'Change',
               title: 'Save changed reference.',
               tabindex: increment_tab_index
    %>
<br>
<br>
<% end %>

