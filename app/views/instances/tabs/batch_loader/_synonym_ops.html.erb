<%# NSL-5567: a name already in a batch is a warning, not a block - the
    records are listed, and the form is still offered. %>
<% if @instance.loader_names.size > 0 %>
  <%= render partial: "instances/tabs/batch_loader/synonym_ops/linked_loader_names" %>
  <br>
<% end %>
<% if @instance.unpublished_citation? %>
  Unsourced synonyms don't get offered an action here
<% elsif @instance.instance_type.name == 'trade name' %>
  Trade Name synonyms don't get offered an action here
<% else %>
  <%= render partial: "instances/tabs/batch_loader/form_to_flip_synonym_into_batch" %>
<% end %>
