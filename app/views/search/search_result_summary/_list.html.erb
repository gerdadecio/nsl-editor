      <% if @search.executed_query.try('summary').present? %>
        <%= @search.executed_query.summary %>
      <% elsif !@search.executed_query.do_count_totals %>
        Not counting totals
      <% elsif @search.executed_query.count == 0 %>
        <% records_found = false %>
        No records found. 
      <% else %>
        <% records_found = true %>
        <% if @search.parsed_request.defined_query %>
          <%= "#{pluralize(@search.executed_query.count,"record")}" %>
          <% if @search.executed_query.results.present? && @search.executed_query.results.size >= @search.parsed_request.limit %>
            of an unknown total
            <strong title="Limited.  To see more records add larger limit to the search e.g. ' limit: 999'." >(limited)</strong>
          <% end %>
        <% else %>
          <%# NOTES (limit/total redesign, follow-up): .count, not
              .results.size - for a References search with show-instances:/
              show-novelties:, .results is references+instances (or
              references+novelties) interleaved, while .count is references
              only (see Search::OnModel::Base#run_list_query). Using
              .results.size here compared a mixed-unit numerator against a
              references-only .total, e.g. "4443 of 6755 records" where 4443
              counted instances too. For every other search type routed
              through this branch, .count and .results.size are the same
              value, so this is a no-op there. %>
          <% if @search.executed_query.limited %>
            <% if @search.executed_query.count < @search.executed_query.total %>
              <%= "#{pluralize(@search.executed_query.count,"of #{@search.executed_query.total} record")}" %>
            <% elsif @search.executed_query.count <= @search.parsed_request.limit %>
              <%= pluralize(@search.executed_query.count, "record") %>
            <% else %>
              <%= pluralize(@search.executed_query.count, "record") %> of a larger total
            <% end %>
          <% else %>
            <%= "#{pluralize(@search.executed_query.total,"record")}" %>
          <% end %>
        <% end %>
      <% end %>
