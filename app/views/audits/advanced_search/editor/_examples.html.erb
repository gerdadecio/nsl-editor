<h4>Activity search examples</h4>
<h5>List records</h5>
<table class="example-searches table table-striped">
  <% [
      {search_target: "Activity",
       search_string: "5",
       explanation: %Q(Records created or updated in the last 5 days.)},
      {search_target: "Activity",
       search_string: "5 names-only:",
       explanation: %Q(Names created or updated in the last 5 days.)},
      {search_target: "Activity",
       search_string: "date-created: 2015-09-07",
       explanation: %Q(Records created on 7 Sept 2015.)},
      {search_target: "Activity",
       search_string: "date-last-updated: 2015-09-07",
       explanation: %Q(Records last updated on 7 Sept 2015.)},
      {search_target: "Activity",
       search_string: "date-created-or-last-updated: 2015-09-07",
       explanation: %Q(Records created or last updated on 7 Sept 2015.)},
      {search_target: "Activity",
       search_string: "api-name: jira-sync",
       explanation: %Q(Records last changed by the "jira-sync" API.
                       Case-insensitive; use * as a wildcard.)},
      {search_target: "Activity",
       search_string: "api-recorded-at: 2026-06-30",
       explanation: %Q(Records changed by an API on 30 June 2026.)},
      {search_target: "Activity",
       search_string: "api-name: jira-sync* api-recorded-after: 2026-06-30",
       explanation: %Q(Records changed by an API whose name starts with
                       "jira-sync" on or after 30 June 2026.)},
      {search_target: "Activity",
       search_string: "api-recorded-before: 2026-06-30 names-only:",
       explanation: %Q(Names changed by an API before 30 June 2026.)},
      ].each do |val| %>
  <tr>
    <td class="width-30-percent">
      <%= link_to(val[:search_string],
                  search_path(query_string: val[:search_string],
                              query_target: val[:search_target]),
                  class:"blue",
                  title: "Run the described search.") %>
    </td>
    <td><%= val[:explanation].html_safe %></td>
  </tr>
  <% end %>
</table>
<br>
<h5>Count records</h5>
<table class="example-searches table table-striped">
  <% [
      {search_target: "Activity",
       search_string: "count: 5",
       explanation: %Q(Count records created or updated in the last 5 days.)},
      {search_target: "Activity",
       search_string: "count: 5 names-only:",
       explanation: %Q(Count names created or updated in the last 5 days.)},
      {search_target: "Activity",
       search_string: "count: date-created: 2015-09-07",
       explanation: %Q(Count records created on 7 Sept 2015.)},
      {search_target: "Activity",
       search_string: "count: date-last-updated: 2015-09-07",
       explanation: %Q(Count records last updated on 7 Sept 2015.)},
      {search_target: "Activity",
       search_string: "count: date-created-or-last-updated: 2015-09-07",
       explanation: %Q(Count records created or last updated on 7 Sept 2015.)},
      {search_target: "Activity",
       search_string: "count: api-name: jira-sync",
       explanation: %Q(Count records last changed by the "jira-sync" API.)},
      {search_target: "Activity",
       search_string: "count: api-recorded-since: 2026-06-30",
       explanation: %Q(Count records changed by an API on or after 30 June 2026.)},
      ].each do |val| %>
  <tr>
    <td class="width-30-percent">
      <%= link_to(val[:search_string],
                  search_path(query_string: val[:search_string],
                              query_target: val[:search_target]),
                  class:"blue",
                  title: "Run the described search.") %>
    </td>
    <td><%= val[:explanation].html_safe %></td>
  </tr>
  <% end %>
</table>
<br>






