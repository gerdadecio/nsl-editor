
  <% if @name.id.present? %>
  <%# Duplicate of: powered by stimulus-autocomplete instead of the
      vendored typeahead.js/Bloodhound widget - see
      app/views/shared/_autocomplete_field.html.erb. The record's own id
      goes along with every request so a name is never offered as a
      duplicate of itself; Name::AsResolvedTypeahead::ForDuplicateOf
      applies the same exclusion server-side for typed-but-not-picked
      text. %>
  <%= render partial: "shared/autocomplete_field",
             locals: { f: f,
                       wrapper_class: "duplicate-of",
                       id_attribute: :duplicate_of_id,
                       input_id: "duplicate-of-typeahead",
                       input_name: "name[duplicate_of_typeahead]",
                       input_value: @name.duplicate_of.try("full_name"),
                       label: "Duplicate of",
                       title: "Possible duplicate names will be suggested as you type, so please select from the list or type enough to identify a single name.",
                       url: name_duplicate_suggestions_html_path,
                       extra_params: { name_id: @name.id } } %>
  <% end %>
