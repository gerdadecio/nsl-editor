<%# stimulus-autocomplete expects the server to respond with an HTML
    fragment of options, rather than the JSON array the older
    typeahead.js-based endpoints return. `data-autocomplete-value` supplies
    the id that ends up in the hidden field on selection; the visible text
    is the element's own content (or `data-autocomplete-label`, if you want
    to submit something shorter/plainer than what's displayed).

    The "duplicate-of-autocomplete-result" class here must match the class
    styled in app/assets/stylesheets/autocomplete/duplicate_of.css -
    they're two separate files with no compile-time link between them, so
    a rename on one side silently breaks the styling on the other. %>
<% if suggestions.blank? %>
  <li class="duplicate-of-autocomplete-result" role="option" aria-disabled="true">No matches</li>
<% else %>
  <% suggestions.each do |suggestion| %>
    <li class="duplicate-of-autocomplete-result"
        role="option"
        data-autocomplete-value="<%= suggestion[:id] %>">
      <%= suggestion[:value] %>
    </li>
  <% end %>
<% end %>
