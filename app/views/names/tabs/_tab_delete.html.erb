<% increment_tab_index %>

<% if can?(:modify, @name)%>

  <% if @name.allow_delete? %>
    <%= render 'names/widgets/delete_widgets' %>
  <% elsif @name.allow_soft_delete? %>
    <% if @name.deleted_at %>
      Name has been soft-deleted at <%= formatted_timestamp(@name.deleted_at) %>.
    <% else %>
      <%= render 'names/widgets/soft_delete_widgets' %>
    <% end %>
  <% else %>
    <%= render 'names/widgets/cannot_delete_info' %>
  <% end %>
  <br>

  <%= render partial: "names/widgets/delete_dependents_summary", locals: { name: @name } %>

  <div class="error-message-container"></div>
  <div id="search-result-details-info-message-container" class="message-container"></div>
  <div id="search-result-details-error-message-container" class="message-container"></div>

<% else %>
  <span class="message">This name has been soft-deleted and cannot be modified. Please contact your administrator.</span>
<% end %>
