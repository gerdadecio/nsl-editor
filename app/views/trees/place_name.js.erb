$('#placement-error-message-container').addClass('hidden').html("");
$('#placement-message-container')
    .removeClass('hidden')
    .html(markdown("<%= escape_javascript(sanitize(@message)) %>"))
    .append("<%= escape_javascript(tree_change_delay_notice) %>")
    .append('<button onclick="refreshTreeTab(event);">refresh</button>');
$('#new_name_placement_btn').find('i.fa').removeClass('fa-spin');
