$('#confirm_remove_placement').addClass('hidden');
$('#remove-placement-error-message-container').addClass('hidden').html("");
$('#remove-placement-message-container')
    .removeClass('hidden')
    .html(markdown("<%= escape_javascript(sanitize(@message)) %>"))
    .append("<%= escape_javascript(tree_change_delay_notice) %>")
    .append('<button onclick="refreshTreeTab(event)">refresh</button>');
$('#remove_name_placement').find('i.fa').removeClass('fa-spin');

