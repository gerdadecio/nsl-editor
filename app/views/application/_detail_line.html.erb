
<% unless defined? underline %>
  <% underline = true %>
<% end %>

<% if label == '' %>
  <% info_width = ' width-100-percent ' %>
  <% label_width = ' width-0-percent ' %>
<% elsif label.length <= 5 %>
  <% info_width = ' width-90-percent ' %>
  <% label_width = ' width-10-percent ' %>
<% else %>
  <% info_width = ' width-70-percent ' %>
  <% label_width = ' width-30-percent ' %>
<% end %>

<div class="detail-line <%= 'underline' if underline %> <%= 'red' if warn %>">
  <% if info.blank? %>
    <span class="float-start <%= info_width %> no-color">&nbsp;</span>
  <% else %>
    <%# Values the caller marked safe (links, form fields, sanitize output) pass
        through; anything else is sanitized, so stored text can't inject script. %>
    <span class="float-start <%= info_width %>"><%= info.html_safe? ? info : sanitize(info.to_s) %></span>
  <% end %>
  <span class="float-end align-right <%= label_width %> field-label">
    <label class="align-right"><%= label %></label>
  </span>
</div>
<br>
