<% increment_tab_index(0) %>
<% if can? 'user/password_resets', 'create' %>
  <% check = @password_reset_check %>
  <div id="password-reset-form-container">
    <h5>Reset the Active Directory password for <%= @user.user_name %></h5>

    <div class="alert alert-info" role="note">
      <ul>
        <li><strong>Check who's asking.</strong> Make sure the request really comes from <%= @user.full_name %>, for example by calling them back on a number you already have.</li>
        <li>Only NSL accounts can be reset here, not generic Active Directory accounts.</li>
        <li>The Editor makes a temporary password and shows it to you once. Pass it on to them.</li>
        <li>If the account is locked out after too many failed sign-ins, it's unlocked as well.</li>
        <li>Ask them to sign in and change the password straight away, using Change Password.</li>
        <li>A reset doesn't sign them out of any Editor sessions already open. If you think someone else is using the account, tell the NSL system administrator: a reset alone won't stop them.</li>
      </ul>
    </div>

    <% if check && !check.resettable? %>
      <p id="password-reset-check-message" class="error-container"><%= check.message %></p>
    <% else %>
      <% if check&.reason == "unavailable" %>
        <p id="password-reset-check-message" class="error-container"><%= check.message %></p>
      <% elsif check&.locked %>
        <p id="password-reset-locked-message"><strong>This account is locked out.</strong> Resetting the password unlocks it too.</p>
      <% end %>

      <%= form_with url: user_password_reset_path(@user), scope: :password_reset, method: :post,
                    local: false, data: { turbo: false }, html: { id: 'password-reset-form', autocomplete: 'off' } do |f| %>
        <div class="mb-3">
          <%= f.label :admin_password do %>Your own password<span class="red">*</span><% end %>
          <%= f.password_field :admin_password, class: 'form-control', autocomplete: 'current-password',
                               title: 'Enter your own password to confirm the reset', tabindex: increment_tab_index %>
          <p>To confirm it's you. A few wrong attempts pause the reset for a while, before Active Directory would lock you out.</p>
        </div>
        <div class="mb-3 align-right">
          <%= f.submit "Reset password", id: 'password-reset-submit', class: 'btn btn-primary',
                       title: "Reset the password for #{@user.user_name}", tabindex: increment_tab_index,
                       data: { disable_with: 'Resetting...' } %>
        </div>
      <% end %>
    <% end %>
  </div>
  <div id="password-reset-error-message-container" class="error-container message-container"></div>
<% else %>
  <p>You can't reset passwords.</p>
<% end %>
