<%= form_for(@reference,
             as: 'reference',
             role: 'form', remote: true, data: { turbo: false }) do |f| %>
 <% if @reference.errors.any? %>
    <div id="error_explanation" class="red">
      <h6><%= pluralize(@reference.errors.count, "error") %> prohibited this reference from being saved:</h6>
      <ul>
      <% @reference.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>
  <%= hidden_field('form','name', value: 'form') %>

  <div class="form-group align-right">
  <% if @reference.new_record? %>
    <%= link_to 'Cancel','/cancel-new-form',
                 class: "btn btn-primary cancel-new-record-link",
                 title: "Cancel new reference.",
                 data: {element_id: "new-reference-#{params[:random_id]}", tabindex: increment_tab_index}  %>
  <% end %>
  <%= f.submit "Save", id: 'top-save-btn', 
    class: 'btn btn-primary width-5em', 
    disabled: false, 
    title: "Save changes",
    tabindex: increment_tab_index %>
  </div>


  <input type="hidden" name="random_id" value="<%= params[:random_id] %>"/>

  <div class="form-group">
    <label for="reference_ref_type_id">Type<span class="red">*</span></label>
    <%= f.select("ref_type_id",
                 @reference.ref_type_options,
                 { include_blank: true },
                 { class:'form-control give-me-focus', 
                   required: true, 
                   autofocus: true, 
                   title: "Choose the type of reference", 
                   onchange: "RefTypeChange(this);",
                   tabindex: increment_tab_index} ) %>
  </div>


  <%# Parent: on stimulus-autocomplete, instead of the typeahead.js widget
      set up by setUpReferenceParent (now gone).

      live_params sends the type currently chosen in the Type select, which
      restricts which references can be a parent - the old Bloodhound source
      read it from the select on every keystroke the same way, because the
      user can change the type without leaving the form.

      extra_params sends the current reference's id, so a reference is never
      offered as its own parent - the job the old widget's data-current-id
      did. A new reference has no id yet and sends it empty.

      Reference::AsResolvedTypeahead::ForParent is unchanged: it cuts the
      "<citation> | [type]" label at the first "|", and term_delimiter cuts
      the search term there too. The input keeps its dom id for
      update.js.erb. %>
  <%= render "shared/autocomplete_field",
             f: f,
             id_attribute: :parent_id,
             input_id: "reference-parent-typeahead",
             input_name: "reference[parent_typeahead]",
             input_value: @reference.parent.try("citation"),
             label: "Parent",
             title: "Enter the parent or containing reference using the suggestions that are listed when you start typing.",
             url: references_typeahead_on_citation_for_parent_path(format: :html),
             extra_params: { id: @reference.id },
             live_params: { ref_type_id: "reference_ref_type_id" },
             term_delimiter: "|" %>
  <%# Outside the field's own wrapper div: .autocomplete-results is
      positioned at top: 100% of that wrapper, so anything else inside it
      would push the suggestion dropdown down below it. %>
  <p id=current-ref-type-message-about-parent>Please choose a type above before setting the parent.</p>

  <% if @reference.id.present? %>
    <script>
      // Only do this if it is an existing record.  Avoids side-effect that breaks new.js.
      var refTypeKey = $('#reference_ref_type_id option:selected').text().replace(' ','');
      $('#current-ref-type-message-about-parent').html($('div#ref-type-message div#'+ refTypeKey).html());
    </script>
  <% end %>

  <script>
    function RefTypeChange(obj) {
      RespondToType(obj.options[obj.selectedIndex].text);
    }

    function RespondToType(ref_type_text) {
      if (ref_type_text == 'Part') {
        $('.hide-for-part').hide();
        $('.show-for-part').show();
      } else {
        $('.hide-for-part').show();
        $('.show-for-part').hide();
      };
    }
  </script>

  <div id="ref-type-message">
    <div id="Book" class="hidden">A Book can belong to a Series</div>
    <div id="Chapter" class="hidden">A Chapter can belong to a Book</div>
    <div id="Database" class="hidden">A Database cannot belong to another reference - no parent allowed</div>
    <div id="DatabaseRecord" class="hidden">A Database Record can belong to a Database</div>
    <div id="Herbariumannotation" class="hidden">An Herbarium Annotation cannot belong to another reference - no parent allowed</div>
    <div id="Index" class="hidden">An index cannot belong to another reference - no parent allowed </div>
    <div id="Journal" class="hidden">A Journal cannot belong to another reference - no parent allowed</div>
    <div id="Part" class="hidden">A Part should belong to a Paper</div>
    <div id="Paper" class="hidden">A Paper can belong to a Journal</div>
    <div id="PersonalCommunication" class="hidden">A Personal Communication cannot belong to another reference - no parent allowed</div>
    <div id="Section" class="hidden">A Section can belong to a Book</div>
    <div id="Series" class="hidden">A Series cannot belong to another reference - no parent allowed</div>
    <div id="Unknown" class="hidden">An Unknown type reference can belong to another Unknown type reference</div>
  </div>
  <div class="form-group">
    <label for="reference_title">Title<span class="red">*</span></label>
    <%= f.text_field :title, class: 'form-control', required: true, title: "Enter the title", tabindex: increment_tab_index %>
    <p>If no title use 'Not set'</p>
  </div>
  <div class="checkbox">
    <label for="reference_published">
      <%= f.check_box(:published, {class:'checkbox-inline width-1em', title: "Check the box if published", tabindex: increment_tab_index}) %>
      Published
    </label>
  </div>

  <%# Author: on stimulus-autocomplete, instead of the typeahead.js widget
      set up by setUpReferenceAuthor (now gone). Suggestions are labelled
      "<name> | <n> refs | <abbrev>"; Reference::AsResolvedTypeahead::ForAuthor
      cuts the submitted text at the first "|", and term_delimiter cuts the
      search term there too, so editing a filled-in field searches on the
      name alone. The input keeps its dom id for update.js.erb. %>
  <%= render "shared/autocomplete_field",
             f: f,
             id_attribute: :author_id,
             input_id: "reference-author-typeahead",
             input_name: "reference[author_typeahead]",
             input_value: @reference.author.try("name"),
             label: "Author",
             required: true,
             title: "Select the author name from the suggestions that appear when you start typing. This field has ordered fragment searching and frequency searching.",
             url: authors_typeahead_on_name_path(format: :html),
             term_delimiter: "|" %>
  <p>If no author use a dash ('-')</p>

  <div class="form-group">
    <label for="reference_ref_author_role_id">Author role<span class="red">*</span></label><br>
    <%= f.select("ref_author_role_id",
                 RefAuthorRole.options,
                 { include_blank: true },
                 { class:'form-control', required: true, title: "Select the author role", tabindex: increment_tab_index} ) %>
  </div>

  <div class="form-group">
    <label for="reference_edition">Edition</label>
    <%= f.text_field :edition, class: 'form-control hide-for-part', title: "Enter edition details", tabindex: increment_tab_index %>
    <p class='show-for-part'> Do not enter Edition for a Part - it is not allowed </p>
  </div>

  <div class="form-group">
    <label for="reference_volume">Volume</label>
    <%= f.text_field :volume, class: 'form-control hide-for-part', title: "Enter volume details", tabindex: increment_tab_index %>
    <p class="show-for-part"> Do not enter Volume for a Part - it is not allowed </p>
  </div>

  <div class="form-group">
    <label for="reference_pages">Pages/Figures</label>
    <%= f.text_field :pages, class: 'form-control', title: "Enter page or page range(s)", tabindex: increment_tab_index %>
  </div>

  <div class="form-group">
    <label for="reference_day">Publication date</label><br>

    <%= f.text_field :day, type: 'number', min: '1', max: '31', step: '1', class: 'day-of-month-field hide-for-part', title: "Enter an optional day of publication", tabindex: increment_tab_index %>

    <%= select(:reference, :month, options_for_select(month_array_for_select, @reference.month.to_i), {include_blank: ''}, {class: 'month-select hide-for-part', title: 'Enter optional publication month (required if you enter day).', tabindex: increment_tab_index}) %>

    <%= f.text_field :year, type: 'number', min: '1000', max: "#{Time.new.year}", step: '1', class: 'year-field hide-for-part', title: "Enter year of publication (4-digit number)", tabindex: increment_tab_index %>

    <p class='show-for-part'>
        Do not enter publication date for a Part - the parent's publication date will be used.
    </p>
    <p class='hide-for-part'>
        Strictly formatted, partial or full date: day-month-year, month-year, or just year.
    </p>
  </div>
	
  <div class="form-group">
    <label for="reference_publication_date">Publication date text</label>
    <%= f.text_field :publication_date, class: 'form-control hide-for-part', maxlength: 50,
                     title: "Enter publication date", tabindex: increment_tab_index %>
    <p class='show-for-part'>
        Do not enter publication date text for a Part - the parent's publication date text takes precedence
    </p>
    <p class='hide-for-part'>maximum length: 50; example: 3-5 Oct. 1776 </p>
  </div>

  <div class="form-group">
    <label for="reference_notes">Notes</label>
    <%= f.text_area :notes, class: 'form-control', title: "Enter notes", tabindex: increment_tab_index %>
  </div>

  <div class="form-group align-right">
  <% if @tab.blank? %>
    <%= link_to 'Cancel','/cancel-new-form',
                 class: "btn btn-primary cancel-new-record-link",
                 title: "Cancel new reference.",
                 data: {element_id: "new-reference-#{params[:random_id]}", tabindex: increment_tab_index}  %>
  <% end %>
  <%= f.submit "Save", 
    id: 'bottom-save-btn', 
    class: 'btn btn-primary width-5em', 
    disabled: false, 
    title: "Save changes.",
    tabindex: increment_tab_index %>
  </div>

<% end %>

  <script>RespondToType($('#reference_ref_type_id'));</script>

<% if @take_focus %>
  <script>
    $(document).ready(function () {
      document.getElementById('reference_ref_type_id').focus();
    RespondToType('<%= @reference.ref_type.name %>');
    })
  </script>
<% end %>
