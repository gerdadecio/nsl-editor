<% field_id = profile_item_reference.persisted? ? "#{profile_item.id}-#{profile_item_reference.profile_item_id_reference_id}" : profile_item.id %>
<%= form_with model: profile_item_reference, url: url, method: method, remote: true, data: { turbo: false }, html: { data: { type: :json, form_type: 'reference_item_form' }, class: 'prompt-form-save' } do |f| %>
  <!-- Hidden fields with parameters -->
  <%= hidden_field_tag "profile_item_reference[profile_item_id]", profile_item.id %>

  <%# Reference: on stimulus-autocomplete, as in
      instances/_form_create_from_name, instead of the typeahead.js widget
      set up by setUpInstanceReferenceProfileV2 (now gone).

      The shared partial renders the hidden reference_id field inside the
      wrapper. hidden_name and hidden_id keep its param name and per-item
      dom id as they were: the model is namespaced, so the form builder
      would otherwise post profile_profile_item_reference[reference_id],
      and the form is rendered once per profile item. The visible input is
      left unnamed, as before, so only a pick changes what is submitted. %>
  <%= render "shared/autocomplete_field",
             f: f,
             id_attribute: :reference_id,
             hidden_name: "profile_item_reference[reference_id]",
             hidden_id: "reference-id-hidden-#{field_id}",
             input_id: "instance-reference-typeahead-#{field_id}",
             input_name: nil,
             input_value: profile_item_reference.reference_id ? Reference.find(profile_item_reference.reference_id).title : "",
             input_class: "width-100-percent give-me-focus",
             required: true,
             autofocus: true,
             placeholder: "Reference wildcarded order-insensitive citation search",
             title: "Enter the reference.  Typeahead for reference citation, allows unordered fragments.",
             url: references_typeahead_on_citation_path(format: :html),
             term_delimiter: " |" %>
  <label>Reference annotation</label>

    <%= text_field_tag "profile_item_reference[annotation]",
      profile_item_reference.annotation,
      id: "reference-annotation-#{field_id}",
      class: "form-control width-100-percent",
      placeholder: "Enter reference annotation",
      required: false,
      style: "background-color: white;"
    %>

  <%= f.submit 'Add reference', style: 'background-color: #5a5a5a; color: white; border: none; padding: 5px 10px; cursor: pointer; border-radius: 4px; margin-left: 10px; margin-top: 10px; float: right;' %>
<% end %>

<script>
  renderFormPrompt();
</script>
